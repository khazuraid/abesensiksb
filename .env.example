# =====================================================================
# Variabel ini contoh untuk SELF-HOSTED (docker compose).
# Saat deploy via Coolify, isi env di dashboard Coolify (per-resource),
# JANGAN commit nilai asli ke repo. Lihat DEPLOYMENT.md.
# =====================================================================

# Database internal (satu container)
DB_USER=adms
DB_NAME=adms_db
DB_PASSWORD=GANTI_PASSWORD
# DATABASE_URL dibuat otomatis oleh entrypoint dari nilai di atas.

# Catatan Coolify: managed Postgres Coolify membuat user otomatis (mis.
# `absensi`) dengan password random. DATABASE_URL di Coolify harusnya:
#   postgres://<user>:<password>@postgres-internal:5432/<db>
# Pastikan resource Postgres di Coolify TIDAK di-set sebagai "Public".

# Auth
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_64_KARAKTER

# Administrator awal (hanya dipakai jika DB belum punya ADMIN)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_MINIMAL_12_KARAKTER
ADMIN_NAME=Administrator

# CORS & URLs
CORS_ORIGIN=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:8080
WORKER_PUBLIC_URL=http://localhost:8888

# Redis berjalan internal di container yang sama.

# Telegram (opsional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ADMS Security
# Kalau di-set, mesin fingerprint WAJIB kirim query param ?key=<value>
# di tiap request /iclock/*. Kosongkan kalau mesin tidak support.
ADMS_SECRET_KEY=

# Port
WORKER_PORT=8888
WORKER_CONCURRENCY=5
MAX_API_BODY_BYTES=1048576
